# CivicSync Frontend Environment Variables

# Backend API URL (FastAPI Backend for Module 3 on Port 8000)
VITE_API_URL=http://localhost:8000/api

# Firebase Config (for Module 1 features)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-auth-domain.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-storage-bucket.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── RAG / Open-Source AI Stack Environment Variables ──────────────────────────
# Vector Database settings (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=civicsync_knowledge

# Local LLM settings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# AI Provider abstraction settings
# Set to "ollama", "groq", or "gemini"
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=groq

# Optional Cloud API keys (used for fallbacks/comparisons)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Embedding model settings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Reranking settings
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# RAG config
RAG_TOP_K=20
RAG_FINAL_K=5
RAG_MIN_SCORE=0.35

# Chunking config
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

