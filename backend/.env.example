# ═══════════════════════════════════════════════════════════════════════════════
# CivicSync Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Firebase / Firestore (REQUIRED) ───────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
#
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=backend/serviceAccountKey.json

# ─── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Maps ──────────────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email Notification (Disaster Relief Confirmation) ────────────────────────
#
# How to enable real email delivery:
#
# Option 1 — Gmail (recommended for development)
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail".
#   4. Use that 16-character password as SMTP_PASSWORD below.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   (App Password, NOT your login password)
# EMAIL_FROM=CivicSync <your-gmail@gmail.com>
#
# Option 2 — Outlook / Hotmail
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your@outlook.com
# SMTP_PASSWORD=your-outlook-password
# EMAIL_FROM=CivicSync <your@outlook.com>
#
# Option 3 — SendGrid (production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# EMAIL_FROM=CivicSync <noreply@yourdomain.com>
#
# If SMTP_HOST or SMTP_USER is left blank, emails will NOT be sent and
# email_sent will return false in the API response.
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CivicSync <noreply@civicsync.in>
